[Unit]
Description=Video Downloader API (yt-dlp)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/video-api
ExecStart=/home/ubuntu/video-api/venv/bin/python app.py
Restart=always
RestartSec=5
Environment=PORT=5000
Environment=MAX_CONCURRENT=2
Environment=CLEANUP_AGE_SEC=7200
Environment=API_KEY=nBkXH2jT8IOGeWREfUSMAraJu3d4Zh7b

[Install]
WantedBy=multi-user.target
